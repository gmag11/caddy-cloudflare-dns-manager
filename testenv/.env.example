# Cloudflare API token with Zone -> DNS -> Edit permission on CF_ZONE.
CF_API_TOKEN=replace-me

# Apex zone managed by the plugin. Used by the Caddyfile (`*.{$CF_ZONE}`,
# `test1.{$CF_ZONE}`, ...).
CF_ZONE=example.com

# Stable instance id for ownership tagging (survives container recreation).
CF_INSTANCE=caddy-test

# Account-scoped Cloudflare API token with Account -> Cloudflare Tunnel -> Edit.
# Required for tunnel ingress management: the plugin writes the tunnel's
# ingress plan with it. Note the blast radius: this token can reconfigure every
# tunnel in the account, unlike the zone-scoped CF_API_TOKEN above.
# The account id needs no configuration: it is derived from the zone lookup,
# because a tunnel and its zone always live in the same account.
CF_ACCOUNT_TUNNEL_TOKEN=replace-me

# Remotely-managed test tunnel, provisioned by testenv/create-tunnel.sh.
# Blank BOTH this line and CF_TUNNEL_ID below, then run the script: it creates
# the tunnel (named after CF_INSTANCE) and fills both values in. The values on
# these two lines count as configured even as placeholders, so the script only
# acts once they are empty.
CF_TUNNEL_TOKEN=replace-me

# Tunnel UUID, filled in by testenv/create-tunnel.sh alongside the token.
# Used by the global tunnel registry (not by cloudflared, which takes its
# identity from the token above).
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
