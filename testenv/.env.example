# Cloudflare API token with Zone -> DNS -> Edit permission on CF_ZONE.
CF_API_TOKEN=replace-me

# Apex zone managed by the plugin. Used by the Caddyfile (`*.{$CF_ZONE}`,
# `test1.{$CF_ZONE}`, ...) and by the tunnel wildcard in tunnel/config.yml.
CF_ZONE=example.com

# Stable instance id for ownership tagging (survives container recreation).
CF_INSTANCE=caddy-test

# cloudflared test tunnel (one-time setup, see docker-compose.yml comments)
# Tunnel UUID, shown by `cloudflared tunnel list`. It is also the name of the
# credentials file created by `tunnel create` (testenv/tunnel/<UUID>.json).
# Used to run the tunnel container and by the plugin's `tunnel <uuid>`
# directive in the Caddyfile.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
