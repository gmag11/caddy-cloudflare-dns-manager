# Cloudflare API token with Zone -> DNS -> Edit permission on CF_ZONE.
CF_API_TOKEN=replace-me

# Apex zone managed by the plugin. Used by the Caddyfile (`*.{$CF_ZONE}`,
# `test1.{$CF_ZONE}`, ...).
CF_ZONE=example.com

# Stable instance id for ownership tagging (survives container recreation).
CF_INSTANCE=caddy-test

# Account-scoped Cloudflare API token with Account -> Cloudflare Tunnel -> Edit.
# Required for tunnel ingress management: the plugin writes the tunnel's
# ingress plan with it. Note the blast radius: this token can reconfigure every
# tunnel in the account, unlike the zone-scoped CF_API_TOKEN above.
CF_ACCOUNT_TUNNEL_TOKEN=replace-me

# Cloudflare account id owning the test tunnel (Cloudflare dashboard URL:
# dash.cloudflare.com/<ACCOUNT_ID>/...).
CF_ACCOUNT_ID=replace-me

# Remotely-managed test tunnel (one-time setup, see docker-compose.yml and
# README.md). Create it in the dashboard (Networking > Tunnels > Create a
# tunnel > Cloudflared) and paste the shown run token here. The tunnel's
# ingress rules are written by the plugin, so no config.yml is needed.
CF_TUNNEL_TOKEN=replace-me

# Tunnel UUID, shown by `cloudflared tunnel list` or the tunnel's page in the
# dashboard. Used by the plugin's `tunnel <uuid>` directive (not by
# cloudflared, which takes its identity from the token above).
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
